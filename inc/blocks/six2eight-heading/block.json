{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "six2eight/heading",
	"title": "Six2Eight Heading",
	"category": "common",
	"icon": "heading",
	"description": "A professional, customizable heading block with advanced typography controls and styling options.",
	"keywords": [
		"heading",
		"title",
		"text",
		"typography"
	],
	"textdomain": "six2eight",
	"supports": {
		"html": false,
		"align": [
			"left",
			"center",
			"right"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"attributes": {
		"content": {
			"type": "string",
			"default": ""
		},
		"level": {
			"type": "number",
			"default": 2
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"textColor": {
			"type": "string",
			"default": "#2D2D34"
		},
		"fontSize": {
			"type": "number",
			"default": 60
		},
		"fontWeight": {
			"type": "string",
			"default": "700"
		},
		"lineHeight": {
			"type": "number",
			"default": 72
		},
		"marginTop": {
			"type": "number",
			"default": 20
		},
		"marginBottom": {
			"type": "number",
			"default": 20
		},
		"letterSpacing": {
			"type": "string",
			"default": "0"
		}
	},
	"editorScript": "file:./build/index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./index.php"
}

